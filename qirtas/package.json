{
  "name": "qirtas-platform",
  "version": "4.0.1",
  "description": "منصة قِرطاس — مكتبة رقمية عربية + قاعدة بيانات + لوحة تحكم + نظام حقوق النشر",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "serve": "node --no-warnings server.js",
    "site:build": "node site/tools/build.js",
    "site:serve": "node --no-warnings server.js",
    "db:import": "node --no-warnings pipeline/db-cli.js import",
    "db:export": "node --no-warnings pipeline/db-cli.js export",
    "db:verify": "node --no-warnings pipeline/db-cli.js verify",
    "db:search": "node --no-warnings pipeline/db-cli.js search",
    "db:dups": "node --no-warnings pipeline/db-cli.js dupcheck",
    "db:runs": "node --no-warnings pipeline/db-cli.js runs",
    "db:audit": "node --no-warnings pipeline/db-cli.js audit",
    "books:harvest": "node pipeline/harvest-gutenberg.js",
    "books:fetch": "node pipeline/fetch-gutenberg.js",
    "books:ws": "node pipeline/harvest-wikisource.js --lang=ar",
    "books:ws-en": "node pipeline/harvest-wikisource.js --lang=en",
    "books:openlibrary": "node pipeline/harvest-openlibrary.js",
    "books:licenses": "node pipeline/verify-licenses.js",
    "books:license-labels": "node pipeline/apply-license-labels.js",
    "books:clean": "node pipeline/dedupe.js",
    "books:clean-texts": "node pipeline/clean-texts.js",
    "books:migrate": "node pipeline/migrate-schema.js",
    "books:index": "node pipeline/build-index.js",
    "books:wikisource-legacy": "node pipeline/wikisource.js",
    "audit:sources": "node tools/audit-sources.js docs/SOURCES-AUDIT.md",
    "test:smoke": "node tools/smoke-test.js --sample=8",
    "test:ui": "node tools/cdp-check.js",
    "test:widths": "node tools/width-check.js",
    "backup:create": "node tools/backup.js create",
    "backup:list": "node tools/backup.js list",
    "backup:restore": "node tools/backup.js restore",
    "site:epub": "node --no-warnings site/tools/build-epub.js",
    "verify:integrity": "node --no-warnings tools/integrity-check.js",
    "verify:meta": "node --no-warnings tools/check-metadata.js",
    "books:fix-meta": "node --no-warnings tools/fix-metadata.js",
    "release": "npm run db:export && npm run db:checkpoint && npm run books:index && npm run site:build && npm run site:epub && npm run verify:integrity && npm run test:smoke",
    "books:archive": "node --no-warnings pipeline/harvest-archive.js --lang=ar",
    "books:archive-rescan": "node --no-warnings pipeline/harvest-archive.js --lang=ar --rescan",
    "books:sanitize": "node --no-warnings tools/sanitize-metadata.js",
    "test:live": "node tools/live-audit.js",
    "test:clicks": "node tools/click-audit.js",
    "test:all": "npm run verify:integrity && npm run test:smoke && npm run test:ui && npm run test:widths",
    "books:quality": "node --no-warnings tools/arabic-quality.js",
    "books:quality-fix": "node --no-warnings tools/arabic-quality.js --fix",
    "books:enrich": "node --no-warnings tools/enrich-arabic.js --titles",
    "site:preview": "node site/tools/build.js && node --no-warnings server.js",
    "db:checkpoint": "node --no-warnings tools/db-checkpoint.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
